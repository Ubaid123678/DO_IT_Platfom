# Environment
NODE_ENV=development
PORT=8080

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/do-it-dev
MONGODB_DB_NAME=do-it-platform

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Payments
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
WISE_API_KEY=xxxx

# Email
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=no-reply@example.com

# SMS/OTP
TWILIO_ACCOUNT_SID=ACxxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_PHONE_NUMBER=+1234567890

# Cloud Storage
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_REGION=us-east-1
S3_BUCKET_NAME=do-it-platform-dev

# Geolocation
MAXMIND_LICENSE_KEY=xxxxx

# Platform Config
PLATFORM_FEE_PERCENT=12
CORS_ORIGIN=*

# Admin
ADMIN_JWT_SECRET=admin-super-secret-key-change-this
ADMIN_IP_WHITELIST=127.0.0.1,::1

# Logging
LOG_LEVEL=debug

# OTP debug output (set true only for local debugging)
OTP_DEBUG_MODE=false
